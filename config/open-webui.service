[Unit]
Description=Sovereign Open WebUI
After=network-online.target ollama.service
Requires=ollama.service

[Service]
Type=simple
User=sovereign
WorkingDirectory=/var/lib/sovereign
ExecStart=/opt/sovereign/venv/bin/open-webui serve --port 8080 --host 0.0.0.0
Restart=always
RestartSec=5
Environment="HOST=0.0.0.0"
Environment="PORT=8080"
Environment="OLLAMA_BASE_URL=http://127.0.0.1:11434"
Environment="WEBUI_SECRET_KEY=bc71d5cc90fd731357319ed4adb24efc4216e79329c544742f007eef1621b712"
Environment="WEBUI_NAME=Sovereign AI"
Environment="DATA_DIR=/var/lib/sovereign/openwebui"
Environment="ENABLE_TELEMETRY=false"
Environment="ENABLE_UPDATE_CHECK=false"
Environment="DO_NOT_TRACK=true"
Environment="ENABLE_IMAGE_GENERATION=false"
Environment="ENABLE_COMMUNITY_SHARING=false"
StandardOutput=journal
StandardError=journal
Environment="RAG_EMBEDDING_ENGINE=ollama"
Environment="RAG_EMBEDDING_MODEL=nomic-embed-text"


[Install]
WantedBy=multi-user.target
